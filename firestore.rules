rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Rules for notes collection
    match /notes/{noteId} {
      allow create: if isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isOwner(resource.data.userId);
      
      // Validate note data structure
      function isValidNote() {
        let hasRequiredFields = request.resource.data.keys().hasAll(['title', 'content', 'userId', 'createdAt', 'updatedAt']);
        let hasValidTypes = 
          request.resource.data.title is string &&
          request.resource.data.content is string &&
          request.resource.data.userId is string &&
          request.resource.data.createdAt is timestamp &&
          request.resource.data.updatedAt is timestamp;
        let hasValidTitle = request.resource.data.title.size() <= 100;
        
        return hasRequiredFields && hasValidTypes && hasValidTitle;
      }
      
      // Additional validation for create and update
      allow create, update: if isValidNote();
    }

    // Rules for user profiles (if needed in the future)
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}